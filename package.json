{
  "name": "bigknoxy-portfolio",
  "version": "0.1.0",
  "description": "GameBoy/Tokyo Night themed portfolio",
  "type": "module",
  "scripts": {
    "dev": "bunx astro dev",
    "build": "bunx astro build",
    "build:game": "bunx vite build --config vite.game.config.js",
    "preview": "bunx astro preview",
    "optimize": "bunx astro build --optimize",
    "lint": "bunx prettier --write .",
    "typecheck": "bunx astro check",
    "test": "bun test --preload ./tests/test-setup.ts tests/unit/**/*.test.*",
    "test:unit": "bun test --preload ./tests/test-setup.ts tests/unit/**/*.test.*",
    "test:e2e": "npx playwright test --project=chromium"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/tailwind": "^6.0.2",
    "astro": "^7.3.2",
    "astro-pagefind": "^2.0.1",
    "pagefind": "^1.5.2",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.5.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0"
  },
  "overrides": {
    "sharp": ">=0.35.0",
    "protobufjs": ">=7.6.1",
    "picomatch": ">=4.0.2",
    "brace-expansion": ">=2.1.4",
    "browserslist": ">=4.29.0",
    "fast-uri": ">=3.1.6",
    "nanoid": ">=3.3.18",
    "serialize-javascript": ">=7.0.1"
  }
}
