---
import Header from '../components/layout/Header.astro';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
}

const { title = 'Joshua Knox | Senior Software Engineer', description = 'Senior Software Engineer and Problem Solver dedicated to technical excellence and human kindness.' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="bg-phosphor-bg text-phosphor-green font-mono">
    <div class="phosphor-grid" aria-hidden="true"></div>
    <Header />
    <slot />
  </body>
</html>
